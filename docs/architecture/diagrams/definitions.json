  "02_round_pipeline": {
    "title": "One round t - Feedback is first visible at t+1",
    "size": [
      9,
      11
    ],
    "nodes": [
      {
        "id": "FREEZE",
        "label": "1. Freeze all three observations\nusing completed history through t-1",
        "at": [
          0,
          7
        ]
      },
      {
        "id": "DECIDE",
        "label": "2. Record calls and collect prices\nno current-round rival disclosure",
        "at": [
          0,
          6
        ]
      },
      {
        "id": "STEP",
        "label": "3. Step the market once\ngross rewards = net rewards",
        "at": [
          0,
          5
        ]
      },
      {
        "id": "AUDIT",
        "label": "4. Audit the completed round\nupdate the consecutive-round window",
        "at": [
          0,
          4
        ]
      },
      {
        "id": "ROUTE",
        "label": "5. Compose and route notices\nrecord each recipient's disposition",
        "at": [
          0,
          3
        ]
      },
      {
        "id": "COMMIT",
        "label": "6. Save evidence and round commit\nretain failures and interruptions",
        "at": [
          0,
          2
        ]
      },
      {
        "id": "NEXT",
        "label": "7. Decision t+1 consumes\nonly its authorized pending notice",
        "at": [
          0,
          1
        ]
      },
      {
        "id": "FINAL",
        "label": "After the final round: verify\nand seal complete evidence",
        "at": [
          0,
          0
        ]
      }
    ],
    "edges": [
